# OmegaUse-OfficeVal 固定 Hugging Face Dataset Snapshot 与 Evaluator Git Checkout。
RSI_OFFICEVAL_DATASET_ROOT=../datasets/OmegaUse-OfficeVal-Dataset
RSI_OFFICEVAL_EVALUATOR_ROOT=../datasets/OmegaUse-OfficeVal

# 只在运行时注入给 Model Gateway；Agent 只获得一次性内部令牌。请自行 export，禁止提交真实值。
RSI_PROVIDER_BASE_URL=https://api.zcloudapi.com/v1
RSI_PROVIDER_API_KEY=replace-me

# 可选：为 Claude Code Updater 单独使用 Anthropic Messages 凭据。
# 与 Solver 的 RSI_PROVIDER_* 分开，不要把真实 Key 写入 Experiment/Adapter。
RSI_CLAUDE_PROVIDER_BASE_URL=https://api.zcloudapi.com/v1
RSI_CLAUDE_PROVIDER_API_KEY=replace-me

# CLI Updater 的宿主工具路径只在运行时注入，Adapter 不把某台机器的绝对目录写进 Git。
# 例如：RSI_NODE_BINARY="$(command -v node)"；其余目录按实际安装位置填写。
RSI_NODE_BINARY=replace-with-absolute-node-path
RSI_BWRAP_PATH=replace-with-absolute-bwrap-path
RSI_SETPRIV_PATH=replace-with-absolute-setpriv-path
RSI_CODEX_DISTRIBUTION_ROOT=replace-with-absolute-codex-distribution
RSI_CLAUDE_CODE_DISTRIBUTION_ROOT=replace-with-absolute-claude-distribution
