{
  "apiVersion": "harness-rsi/v1alpha1",
  "kind": "EvolutionExperiment",
  "metadata": { "id": "kernelbench-smoke-msa-single" },
  "spec": {
    "recipe": "recipes/population-smoke/single.yml",
    "adapters": {
      "target": "adapters/targets/msa-minimal-cowork-rsi.yml",
      "updater": "adapters/updaters/deepseek-harness.yml",
      "environment": "environments/kernelbench-gpu.yml",
      "provider": "adapters/providers/zcloud-openai.yml",
      "strategy": "adapters/strategies/linear-hill-climb.yml"
    },
    "benchmark": "benchmarks/kernelbench-smoke-v1/benchmark.json",
    "policy": "evaluation/policies/cowork-rsi-smoke.json",
    "models": {
      "solver": { "provider": "zcloud-openai", "model": "gpt-6.1-sol", "maxTokens": 4096, "reasoningEffort": "medium" },
      "updater": { "provider": "zcloud-openai", "model": "gpt-6.1-sol", "maxTokens": 4096, "reasoningEffort": "medium" }
    },
    "evolution": { "mutationLevel": "l1", "generations": 1, "trialsPerInstance": 1, "seeds": [20261001] }
  }
